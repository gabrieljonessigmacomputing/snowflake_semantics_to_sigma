{
  "name": "snowflake-semantics-to-sigma",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action: sync Snowflake semantic views (YAML or DDL) to Sigma data models",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --import tsx/esm --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/bundle.mjs",
    "build:semantic-tools": "node scripts/build-semantic-tools.mjs",
    "check:semantic-tools": "node scripts/check-semantic-tools.mjs"
  },
  "dependencies": {
    "@actions/artifact": "2.3.2",
    "@actions/core": "1.11.1",
    "@actions/exec": "1.1.1",
    "@actions/github": "6.0.0",
    "@actions/glob": "0.5.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.27.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
